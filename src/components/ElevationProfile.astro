---
interface Props {
  gpxFile: string;
  gpxFileShort?: string;
  dayNumber: number;
}

const { gpxFile, gpxFileShort, dayNumber } = Astro.props;
const profileId = `elevation-profile-${dayNumber}`;
---

<section
  class="elevation-profile mb-4 overflow-hidden rounded-lg border border-navy-100 bg-navy-50/50"
  data-profile-id={profileId}
  data-day-number={dayNumber}
  data-gpx={gpxFile}
  aria-labelledby={`${profileId}-title`}
>
  <div class="flex items-center justify-between gap-3 border-b border-navy-100 px-3 py-2">
    <h4
      id={`${profileId}-title`}
      class="text-[10px] font-bold uppercase tracking-wider text-navy-400"
    >
      Hoogteprofiel
    </h4>

    <div class="flex items-center gap-2">
      <span
        class="rounded bg-orange-50 px-1.5 py-0.5 text-[10px] font-bold text-orange-700"
        data-profile-peak>…</span
      >

      {gpxFileShort && (
        <div class="profile-switch" role="group" aria-label="Kies route">
          <button
            type="button"
            class="profile-selector"
            data-route="long"
            data-gpx={gpxFile}
            aria-pressed="true"
          >
            Lang
          </button>
          <button
            type="button"
            class="profile-selector"
            data-route="short"
            data-gpx={gpxFileShort}
            aria-pressed="false"
          >
            Kort
          </button>
        </div>
      )}
    </div>
  </div>

  <div class="p-3">
    <div class="relative">
      <svg
        class="block h-auto w-full"
        viewBox="0 0 600 200"
        role="img"
        aria-label={`Hoogteprofiel van dag ${dayNumber}`}
        data-profile-chart
      >
        <title data-profile-title>Hoogteprofiel wordt geladen</title>
        <defs>
          <linearGradient id={`${profileId}-fill`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#3fb5ba" stop-opacity="0.3"></stop>
            <stop offset="100%" stop-color="#3fb5ba" stop-opacity="0.02"></stop>
          </linearGradient>
        </defs>

        <g data-profile-grid stroke="#d4d9de" stroke-width="1"></g>
        <g data-profile-y-labels fill="#7e8d9e" font-size="10" text-anchor="end"></g>
        <g data-profile-x-labels fill="#7e8d9e" font-size="10"></g>

        <path data-profile-area fill={`url(#${profileId}-fill)`}></path>
        <path
          data-profile-line
          fill="none"
          stroke="#359ba0"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        <circle
          data-profile-high-point
          r="3.5"
          fill="#f59e0b"
          stroke="white"
          stroke-width="2"
          opacity="0"></circle>

        <g data-profile-cursor opacity="0">
          <line y1="16" y2="168" stroke="#2c4a5e" stroke-width="1" stroke-dasharray="2 3"></line>
          <circle r="4" fill="#359ba0" stroke="white" stroke-width="2"></circle>
        </g>
      </svg>

      <div
        class="pointer-events-none absolute top-0 -translate-x-1/2 -translate-y-1 rounded-md bg-navy-800 px-2 py-1 text-[11px] font-semibold whitespace-nowrap text-white opacity-0 transition-opacity"
        data-profile-tooltip
      >
      </div>
    </div>
  </div>
</section>

<style>
  .profile-switch {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: 9999px;
    background-color: white;
    border: 1px solid var(--color-navy-100);
  }

  .profile-selector {
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-navy-400);
    transition:
      background-color 150ms ease,
      color 150ms ease;
    cursor: pointer;
  }

  .profile-selector:hover {
    color: var(--color-navy-700);
  }

  .profile-selector[aria-pressed="true"] {
    background-color: var(--color-turquoise-500);
    color: white;
  }
</style>

<script>
  const PLOT = { left: 42, right: 592, top: 16, bottom: 168 };
  const SAMPLE_COUNT = 200;
  const MAX_TICKS = 5;
  const ELEVATION_STEPS = [10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000];
  const DISTANCE_STEPS = [1, 2, 5, 10, 20, 25, 50, 100, 200];

  type Sample = { distance: number; elevation: number };

  /** Smallest round step that keeps the axis under MAX_TICKS labels. */
  const niceStep = (range: number, steps: number[]) =>
    steps.find((step) => range / step <= MAX_TICKS) ?? steps[steps.length - 1];

  const parsePoints = (xml: Document) =>
    Array.from(xml.querySelectorAll("trkpt"))
      .map((point) => ({
        lat: Number(point.getAttribute("lat")),
        lon: Number(point.getAttribute("lon")),
        elevation: Number(point.querySelector("ele")?.textContent),
      }))
      .filter(
        (point) =>
          Number.isFinite(point.lat) &&
          Number.isFinite(point.lon) &&
          Number.isFinite(point.elevation),
      );

  const cumulativeDistances = (points: { lat: number; lon: number }[]) => {
    const distances = [0];
    for (let index = 1; index < points.length; index += 1) {
      const previous = points[index - 1];
      const current = points[index];
      const latitude = ((current.lat - previous.lat) * Math.PI) / 180;
      const longitude = ((current.lon - previous.lon) * Math.PI) / 180;
      const meanLatitude = ((current.lat + previous.lat) * Math.PI) / 360;
      const distance = 6371 * Math.sqrt(latitude ** 2 + (Math.cos(meanLatitude) * longitude) ** 2);
      distances.push(distances[index - 1] + distance);
    }
    return distances;
  };

  /**
   * GPX tracks hold thousands of unevenly spaced points, which draw as a noisy
   * line. Resample to a fixed number of evenly spaced samples, then smooth away
   * the remaining barometer jitter.
   */
  const resample = (
    points: { elevation: number }[],
    distances: number[],
    totalDistance: number,
  ): Sample[] => {
    const raw: Sample[] = [];
    let cursor = 0;

    for (let index = 0; index < SAMPLE_COUNT; index += 1) {
      const target = (totalDistance * index) / (SAMPLE_COUNT - 1);
      while (cursor < distances.length - 2 && distances[cursor + 1] < target) cursor += 1;
      const span = distances[cursor + 1] - distances[cursor];
      const ratio = span > 0 ? (target - distances[cursor]) / span : 0;
      const elevation =
        points[cursor].elevation +
        (points[cursor + 1].elevation - points[cursor].elevation) * ratio;
      raw.push({ distance: target, elevation });
    }

    return raw.map((sample, index) => {
      const from = Math.max(index - 1, 0);
      const to = Math.min(index + 1, raw.length - 1);
      let total = 0;
      for (let i = from; i <= to; i += 1) total += raw[i].elevation;
      return { distance: sample.distance, elevation: total / (to - from + 1) };
    });
  };

  const drawElevationProfiles = () => {
    document.querySelectorAll<HTMLElement>("[data-profile-id]").forEach((profile) => {
      const svg = profile.querySelector<SVGSVGElement>("[data-profile-chart]");
      const line = profile.querySelector<SVGPathElement>("[data-profile-line]");
      const area = profile.querySelector<SVGPathElement>("[data-profile-area]");
      const grid = profile.querySelector<SVGGElement>("[data-profile-grid]");
      const yLabels = profile.querySelector<SVGGElement>("[data-profile-y-labels]");
      const xLabels = profile.querySelector<SVGGElement>("[data-profile-x-labels]");
      const highPoint = profile.querySelector<SVGCircleElement>("[data-profile-high-point]");
      const cursor = profile.querySelector<SVGGElement>("[data-profile-cursor]");
      const cursorLine = cursor?.querySelector("line");
      const cursorDot = cursor?.querySelector("circle");
      const tooltip = profile.querySelector<HTMLElement>("[data-profile-tooltip]");
      const chartTitle = profile.querySelector<SVGTitleElement>("[data-profile-title]");
      const peakLabel = profile.querySelector<HTMLElement>("[data-profile-peak]");
      const initialGpx = profile.dataset.gpx;

      if (
        !svg || !line || !area || !grid || !yLabels || !xLabels || !highPoint ||
        !cursor || !cursorLine || !cursorDot || !tooltip || !chartTitle ||
        !peakLabel || !initialGpx
      ) {
        return;
      }

      let samples: Sample[] = [];
      let toX: (distance: number) => number = () => 0;
      let toY: (elevation: number) => number = () => 0;

      const renderAxes = (totalDistance: number, minElevation: number, maxElevation: number) => {
        grid.replaceChildren();
        yLabels.replaceChildren();
        xLabels.replaceChildren();

        // Scale to the ride's own range rather than snapping the floor to a
        // round number — an 1800 m climb starting at 300 m would otherwise
        // waste the bottom half of the plot on empty valley.
        const padding = Math.max((maxElevation - minElevation) * 0.12, 10);
        const domainMin = minElevation - padding;
        const domainMax = maxElevation + padding;

        toX = (distance) =>
          PLOT.left + (distance / totalDistance) * (PLOT.right - PLOT.left);
        toY = (elevation) =>
          PLOT.bottom -
          ((elevation - domainMin) / (domainMax - domainMin)) * (PLOT.bottom - PLOT.top);

        const elevationStep = niceStep(domainMax - domainMin, ELEVATION_STEPS);
        const firstLine = Math.ceil(domainMin / elevationStep) * elevationStep;

        for (let value = firstLine; value <= domainMax; value += elevationStep) {
          const y = toY(value);
          const gridLine = document.createElementNS("http://www.w3.org/2000/svg", "line");
          gridLine.setAttribute("x1", String(PLOT.left));
          gridLine.setAttribute("x2", String(PLOT.right));
          gridLine.setAttribute("y1", y.toFixed(1));
          gridLine.setAttribute("y2", y.toFixed(1));
          grid.append(gridLine);

          const isTop = value + elevationStep > domainMax;
          const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
          label.setAttribute("x", String(PLOT.left - 8));
          label.setAttribute("y", (y + 3.5).toFixed(1));
          label.textContent = isTop ? `${Math.round(value)} m` : `${Math.round(value)}`;
          yLabels.append(label);
        }

        const distanceStep = niceStep(totalDistance, DISTANCE_STEPS);
        for (let value = 0; value <= totalDistance + 0.001; value += distanceStep) {
          const isFirst = value === 0;
          const isLast = value + distanceStep > totalDistance;
          const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
          label.setAttribute("x", toX(value).toFixed(1));
          label.setAttribute("y", String(PLOT.bottom + 20));
          label.setAttribute("text-anchor", isFirst ? "start" : isLast ? "end" : "middle");
          label.textContent = isLast ? `${Math.round(value)} km` : `${Math.round(value)}`;
          xLabels.append(label);
        }
      };

      const loadProfile = async (gpxPath: string) => {
        peakLabel.textContent = "…";
        const response = await fetch(gpxPath);
        const gpx = new DOMParser().parseFromString(await response.text(), "text/xml");
        const points = parsePoints(gpx);

        if (points.length < 2) {
          peakLabel.textContent = "Geen data";
          chartTitle.textContent = "Geen hoogtegegevens beschikbaar";
          return;
        }

        const distances = cumulativeDistances(points);
        const totalDistance = distances[distances.length - 1];
        samples = resample(points, distances, totalDistance);

        const elevations = samples.map((sample) => sample.elevation);
        const minElevation = Math.min(...elevations);
        const maxElevation = Math.max(...elevations);
        const peak = samples[elevations.indexOf(maxElevation)];
        const ascent = samples.reduce(
          (total, sample, index) =>
            index === 0
              ? total
              : total + Math.max(sample.elevation - samples[index - 1].elevation, 0),
          0,
        );

        renderAxes(totalDistance, minElevation, maxElevation);

        const linePath = samples
          .map(
            (sample, index) =>
              `${index === 0 ? "M" : "L"}${toX(sample.distance).toFixed(1)} ${toY(sample.elevation).toFixed(1)}`,
          )
          .join(" ");

        line.setAttribute("d", linePath);
        area.setAttribute(
          "d",
          `${linePath} L${PLOT.right} ${PLOT.bottom} L${PLOT.left} ${PLOT.bottom} Z`,
        );
        highPoint.setAttribute("cx", toX(peak.distance).toFixed(1));
        highPoint.setAttribute("cy", toY(peak.elevation).toFixed(1));
        highPoint.setAttribute("opacity", "1");

        peakLabel.textContent = `Top ${Math.round(maxElevation).toLocaleString("nl-NL")} m`;
        chartTitle.textContent = `Hoogteprofiel van ${totalDistance.toFixed(1)} kilometer, van ${Math.round(samples[0].elevation)} tot ${Math.round(samples[samples.length - 1].elevation)} meter, met een hoogste punt op ${Math.round(maxElevation)} meter en ${Math.round(ascent)} hoogtemeters klimmen`;
      };

      const showCursor = (event: PointerEvent) => {
        if (!samples.length) return;

        const bounds = svg.getBoundingClientRect();
        const scale = bounds.width / 600;
        const x = (event.clientX - bounds.left) / scale;
        const ratio = Math.min(Math.max((x - PLOT.left) / (PLOT.right - PLOT.left), 0), 1);
        const sample = samples[Math.round(ratio * (samples.length - 1))];
        const sampleX = toX(sample.distance);

        cursorLine.setAttribute("x1", sampleX.toFixed(1));
        cursorLine.setAttribute("x2", sampleX.toFixed(1));
        cursorDot.setAttribute("cx", sampleX.toFixed(1));
        cursorDot.setAttribute("cy", toY(sample.elevation).toFixed(1));
        cursor.setAttribute("opacity", "1");

        tooltip.textContent = `${sample.distance.toLocaleString("nl-NL", { maximumFractionDigits: 1 })} km · ${Math.round(sample.elevation).toLocaleString("nl-NL")} m`;
        tooltip.style.left = `${Math.min(Math.max((sampleX / 600) * 100, 12), 88)}%`;
        tooltip.style.opacity = "1";
      };

      const hideCursor = () => {
        cursor.setAttribute("opacity", "0");
        tooltip.style.opacity = "0";
      };

      svg.addEventListener("pointermove", showCursor);
      svg.addEventListener("pointerleave", hideCursor);

      const fail = () => {
        peakLabel.textContent = "Geen data";
        chartTitle.textContent = "Hoogteprofiel niet beschikbaar";
      };

      const dayNumber = Number(profile.getAttribute("data-day-number"));

      const setRouteMode = (mode: "long" | "short") => {
        const button = profile.querySelector<HTMLButtonElement>(
          `.profile-selector[data-route="${mode}"]`,
        );
        if (!button) return;

        const currentMode = profile.querySelector<HTMLButtonElement>(
          '.profile-selector[aria-pressed="true"]',
        )?.dataset.route;
        if (currentMode === mode) return;

        profile
          .querySelectorAll<HTMLButtonElement>(".profile-selector")
          .forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        hideCursor();
        if (button.dataset.gpx) loadProfile(button.dataset.gpx).catch(fail);
      };

      profile.querySelectorAll<HTMLButtonElement>(".profile-selector").forEach((button) => {
        button.addEventListener("click", () => {
          const mode = button.dataset.route as "long" | "short" | undefined;
          if (!mode || !Number.isFinite(dayNumber)) return;
          setRouteMode(mode);
          window.dispatchEvent(
            new CustomEvent("route-mode-change", {
              detail: { dayNumber, mode },
            }),
          );
        });
      });

      window.addEventListener("route-mode-change", (event: Event) => {
        const customEvent = event as CustomEvent<{ dayNumber?: number; mode?: "long" | "short" }>;
        if (!customEvent.detail || customEvent.detail.dayNumber !== dayNumber || !customEvent.detail.mode) {
          return;
        }
        setRouteMode(customEvent.detail.mode);
      });

      // GPX files run up to a megabyte, so only fetch once the card is in view.
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          loadProfile(initialGpx).catch(fail);
        },
        { rootMargin: "200px" },
      );
      observer.observe(profile);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", drawElevationProfiles);
  } else {
    drawElevationProfiles();
  }
</script>
