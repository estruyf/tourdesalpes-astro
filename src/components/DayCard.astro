---
import type { Day } from "../data/trip";
import ElevationProfile from "./ElevationProfile.astro";
import InteractiveMap from "./InteractiveMap.astro";

interface Props {
  day: Day;
}

const { day } = Astro.props;
---

<article
  class="group relative bg-white rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 border border-navy-100 overflow-hidden mb-12"
>
  {/* Left decorative bar */}
  <div
    class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-turquoise-500 to-navy-600"
  >
  </div>

  <div class="grid lg:grid-cols-12 gap-0 h-full">
    {/* Content Side */}
    <div class="lg:col-span-5 p-8 flex flex-col h-full bg-white relative z-10">
      <header class="mb-6 relative">
        <div class="flex items-center gap-3 mb-2">
          <span
            class="inline-flex items-center justify-center h-6 px-2.5 rounded-full bg-navy-100 text-navy-700 text-xs font-bold uppercase tracking-wider"
          >
            Dag {day.dayNumber}
          </span>
          <time
            datetime={day.date}
            class="text-sm font-medium text-gray-400 uppercase tracking-widest"
          >
            {
              new Date(day.date).toLocaleDateString("nl-NL", {
                weekday: "long",
                day: "numeric",
                month: "long",
              })
            }
          </time>
        </div>
        <h3
          class="text-3xl font-extrabold text-navy-900 leading-tight tracking-tight"
        >
          {day.title}
        </h3>
      </header>

      {
        day.ride && (
          <div
            class="grid grid-cols-2 gap-3 mb-8"
            data-day-metrics
            data-day-number={day.dayNumber}
            data-distance-long={day.ride.distance}
            data-elevation-long={day.ride.elevation}
            data-distance-short={day.ride.distanceShort}
            data-elevation-short={day.ride.elevationShort}
          >
            <div class="px-4 py-3 bg-navy-50 rounded-xl border border-navy-100">
              <div class="text-[10px] sm:text-xs text-navy-400 font-bold uppercase tracking-wider mb-1">
                Afstand
              </div>
              <div
                class="text-2xl font-black text-navy-800 tracking-tight"
                data-day-distance
              >
                {day.ride.distance}{" "}
                <span class="text-sm font-medium text-navy-400 ml-0.5">km</span>
              </div>
            </div>
            <div class="px-4 py-3 bg-navy-50 rounded-xl border border-navy-100">
              <div class="text-[10px] sm:text-xs text-navy-400 font-bold uppercase tracking-wider mb-1">
                Hoogtemeters
              </div>
              <div
                class="text-2xl font-black text-navy-800 tracking-tight"
                data-day-elevation
              >
                {day.ride.elevation}{" "}
                <span class="text-sm font-medium text-navy-400 ml-0.5">m</span>
              </div>
            </div>
          </div>
        )
      }

      {
        day.ride ? (
          <div class="prose prose-sm prose-navy text-gray-500 mb-4 leading-relaxed max-w-none">
            <p>{day.ride.description}</p>
          </div>
        ) : (
          <div class="flex-grow flex flex-col items-center justify-center p-8 text-center bg-gray-50/50 rounded-2xl border border-dashed border-gray-200 my-4">
            <p class="font-medium text-navy-800">Reisdag</p>
            <p class="text-sm text-gray-500 mt-1">Geen rit gepland vandaag.</p>
          </div>
        )
      }

      {
        day.ride?.gpxFile && (
          <ElevationProfile
            gpxFile={day.ride.gpxFile}
            gpxFileShort={day.ride.gpxFileShort}
            dayNumber={day.dayNumber}
          />
        )
      }

      {/* Hotel Info */}
      {
        day.hotel && (
          <div class="mb-4 bg-navy-50/50 rounded-lg border border-navy-100 overflow-hidden">
            <div class="px-3 py-2 border-b border-navy-100 flex items-center justify-between gap-3">
              <span class="text-[10px] font-bold text-navy-400 uppercase tracking-wider">
                Hotel
              </span>
              {day.hotel.evCharging && (
                <span class="text-[10px] font-bold text-green-600 bg-green-50 px-1.5 py-0.5 rounded">
                  ⚡ EV
                </span>
              )}
            </div>
            <div class="p-3">
              <div class="font-bold text-navy-900 text-sm mb-1">
                {day.hotel.name}
              </div>
              <div class="text-xs text-gray-500 mb-2">{day.hotel.address}</div>
              <div class="flex flex-wrap gap-1">
                {day.hotel.rooms.map((room) => (
                  <span class="text-[10px] bg-white px-1.5 py-0.5 rounded text-gray-600 border border-gray-200">
                    {room}
                  </span>
                ))}
              </div>
            </div>
          </div>
        )
      }

      {/* Downloads */}
      {
        day.ride && (day.ride.gpxFile || day.ride.gpxFileShort) && (
          <div class="mt-auto pt-6 border-t border-gray-100 flex gap-3">
            {day.ride.gpxFile && (
              <a
                href={day.ride.gpxFile}
                download
                class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-navy-800 text-white rounded-lg hover:bg-navy-700 transition-all shadow-sm shadow-navy-200 text-sm font-semibold group"
              >
                <svg
                  class="w-4 h-4 text-turquoise-400 group-hover:text-turquoise-300"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  />
                </svg>
                GPX {day.ride.gpxFileShort ? "Lang" : "Route"}
              </a>
            )}
            {day.ride.gpxFileShort && (
              <a
                href={day.ride.gpxFileShort}
                download
                class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-white text-navy-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-all text-sm font-semibold"
              >
                <svg
                  class="w-4 h-4 text-gray-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  />
                </svg>
                GPX Kort
              </a>
            )}
          </div>
        )
      }
    </div>

    {/* Map Side */}
    <div
      class="lg:col-span-7 bg-gray-50 relative min-h-[400px] lg:h-full border-l border-gray-100"
    >
      {
        day.ride && day.ride.gpxFile ? (
          <div class="absolute inset-0 z-0">
            <InteractiveMap
              gpxFile={day.ride.gpxFile}
              gpxFileShort={day.ride.gpxFileShort}
              dayNumber={day.dayNumber}
              title={day.title}
            />
          </div>
        ) : (
          <div class="absolute inset-0 flex items-center justify-center opacity-10 pointer-events-none">
            <span class="text-8xl font-black text-gray-900 tracking-tighter mix-blend-overlay">
              DAG {day.dayNumber}
            </span>
          </div>
        )
      }

      {/* Cols badges on Map */}
      <div class="absolute top-4 left-4 right-4 z-[400]">
        {
          day.ride && day.ride.cols && day.ride.cols.length > 0 && (
            <div class="flex flex-wrap gap-2 justify-end">
              {day.ride.cols.map((col) => (
                <span class="inline-flex items-center gap-1.5 bg-navy-900/90 backdrop-blur text-white text-xs font-medium px-2.5 py-1.5 rounded-lg shadow-lg border border-white/10">
                  {col.name}{" "}
                  <span class="text-turquoise-400 font-bold">
                    {col.elevation}m
                  </span>
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</article>
