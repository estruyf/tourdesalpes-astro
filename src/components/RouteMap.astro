---
import type { Town } from "../data/trip";

interface Props {
  gpxFiles: string[];
  towns: Town[];
}

const { gpxFiles, towns } = Astro.props;
const mapId = "route-map";
const townsJson = JSON.stringify(towns);
const gpxFilesJson = JSON.stringify(gpxFiles);
---

<div class="route-map h-full">
  <div
    id={mapId}
    class="h-full w-full rounded-b-3xl shadow-inner border border-gray-200"
    data-towns={townsJson}
    data-gpx-files={gpxFilesJson}
  >
  </div>
</div>

<script>
  if (typeof window !== "undefined") {
    const initRouteMap = () => {
      if (typeof L === "undefined") {
        setTimeout(initRouteMap, 100);
        return;
      }

      const mapElement = document.getElementById("route-map");
      if (!mapElement) return;

      const map = L.map("route-map", {
        scrollWheelZoom: false,
      });

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "© OpenStreetMap contributors",
        maxZoom: 19,
      }).addTo(map);

      const townsData = mapElement.getAttribute("data-towns") || "[]";
      const gpxFilesData = mapElement.getAttribute("data-gpx-files") || "[]";
      const towns = JSON.parse(townsData);
      const gpxFiles = JSON.parse(gpxFilesData);

      const parseGpxLatLngs = (gpxText) => {
        const parser = new DOMParser();
        const gpxDoc = parser.parseFromString(gpxText, "text/xml");
        const trackPoints = gpxDoc.querySelectorAll("trkpt");
        const latLngs = [];

        trackPoints.forEach((point) => {
          const lat = parseFloat(point.getAttribute("lat") || "0");
          const lon = parseFloat(point.getAttribute("lon") || "0");
          if (lat && lon) {
            latLngs.push([lat, lon]);
          }
        });

        return latLngs;
      };

      const townLayer = L.featureGroup();
      towns.forEach((town) => {
        const marker = L.circleMarker([town.lat, town.lon], {
          radius: 6,
          color: "#0f172a",
          weight: 2,
          fillColor: "#f59e0b",
          fillOpacity: 0.95,
        }).addTo(map);

        marker.bindTooltip(town.name, {
          permanent: true,
          direction: "top",
          offset: [0, -10],
          className: "town-label",
        });

        townLayer.addLayer(marker);
      });

      Promise.all(
        gpxFiles.map((gpxFile) =>
          fetch(gpxFile)
            .then((response) => response.text())
            .then(parseGpxLatLngs)
            .catch(() => []),
        ),
      ).then((routes) => {
        const allLatLngs = routes.flat();
        const layers = [townLayer];

        if (allLatLngs.length) {
          const routeLine = L.polyline(allLatLngs, {
            color: "#ef4444",
            weight: 4,
            opacity: 0.8,
          }).addTo(map);

          layers.unshift(routeLine);
        }

        const boundsGroup = L.featureGroup(layers);
        if (boundsGroup.getLayers().length) {
          map.fitBounds(boundsGroup.getBounds(), { padding: [30, 30] });
        } else {
          map.setView([44.5, 6.2], 6);
        }
      });

      map.on("click", () => {
        map.scrollWheelZoom.enable();
      });

      map.on("mouseout", () => {
        map.scrollWheelZoom.disable();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initRouteMap);
    } else {
      initRouteMap();
    }
  }
</script>

<style>
  .town-label {
    background: rgba(15, 23, 42, 0.9);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.25);
  }
</style>
