---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import RouteMap from "../components/RouteMap.astro";
import { routeGpxFiles, routeTowns, tripStats } from "../data/trip";
---

<BaseLayout title="Tour des Alpes Yves achterna">
  <!-- Jersey-Inspired Hero -->
  <section
    class="relative bg-gradient-to-br from-turquoise-400 via-turquoise-500 to-navy-600 text-navy-900 py-14 sm:py-20 overflow-hidden"
  >
    {/* Animated Gradient Orbs */}
    <div
      class="absolute -top-40 -right-40 w-80 h-80 bg-gradient-to-br from-orange-400/30 to-transparent rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-40 w-96 h-96 bg-gradient-to-tr from-navy-700/40 to-transparent rounded-full blur-3xl"
    >
    </div>

    {/* Checkered Pattern Accent */}
    <div
      class="absolute top-0 left-0 right-0 h-16 checkered-pattern opacity-10"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8">
      <div class="text-center mx-auto space-y-6">
        {/* Logo */}
        <div class="flex justify-center">
          <div
            class="w-24 h-24 sm:w-32 sm:h-32 rounded-full p-2 shadow-lg bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-500"
          >
            <img
              src="/suffering-giving-up-transparent.png"
              alt="King of the King Logo"
              class="w-full h-full drop-shadow-[0_0_6px_rgba(255,215,0,0.7)]"
            />
          </div>
        </div>

        {/* Date Badge */}
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 text-white shadow-xl hover:shadow-orange-500/50 transition-all duration-300 border border-white/20"
        >
          <svg
            class="w-3.5 h-3.5 text-yellow-200 animate-pulse"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"></path>
          </svg>
          <span class="text-[11px] sm:text-xs font-bold tracking-wide">
            7-15 September 2026
          </span>
        </div>

        {/* Title */}
        <div class="space-y-2">
          <h1
            class="text-3xl sm:text-5xl md:text-7xl font-black tracking-tight leading-tight bg-gradient-to-r from-navy-900 to-navy-700 bg-clip-text text-transparent drop-shadow-lg"
          >
            Tour des Alpes
          </h1>
          <p
            class="text-lg sm:text-2xl font-bold text-navy-700/90 tracking-wide drop-shadow"
          >
            Yves achterna
          </p>
        </div>

        {/* Stats Grid */}
        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 max-w-3xl mx-auto pt-6"
        >
          <div
            class="bg-gradient-to-br from-white/95 to-white/80 backdrop-blur rounded-2xl p-3 sm:p-4 shadow-xl hover:shadow-2xl hover:from-white to-white/90 transition-all duration-300 border border-white/40 hover:border-orange-300/60"
          >
            <div
              class="text-3xl sm:text-4xl font-black bg-gradient-to-r from-navy-900 to-navy-700 bg-clip-text text-transparent"
              data-total-distance={tripStats.totalDistance}
            >
              {tripStats.totalDistance}
            </div>
            <div
              class="text-[10px] uppercase tracking-widest text-navy-600 font-bold mt-1"
            >
              Kilometer
            </div>
          </div>
          <div
            class="bg-gradient-to-br from-white/95 to-white/80 backdrop-blur rounded-2xl p-3 sm:p-4 shadow-xl hover:shadow-2xl hover:from-white to-white/90 transition-all duration-300 border border-white/40 hover:border-orange-300/60"
          >
            <div
              class="text-3xl sm:text-4xl font-black bg-gradient-to-r from-navy-900 to-navy-700 bg-clip-text text-transparent"
              data-total-elevation={tripStats.totalElevation}
            >
              {tripStats.totalElevation.toLocaleString("nl-NL")}
            </div>
            <div
              class="text-[10px] uppercase tracking-widest text-navy-600 font-bold mt-1"
            >
              Hoogtemeters
            </div>
          </div>
          <div
            class="bg-gradient-to-br from-white/95 to-white/80 backdrop-blur rounded-2xl p-3 sm:p-4 shadow-xl hover:shadow-2xl hover:from-white to-white/90 transition-all duration-300 border border-white/40 hover:border-orange-300/60"
          >
            <div
              class="text-3xl sm:text-4xl font-black bg-gradient-to-r from-navy-900 to-navy-700 bg-clip-text text-transparent"
            >
              {tripStats.totalCols}
            </div>
            <div
              class="text-[10px] uppercase tracking-widest text-navy-600 font-bold mt-1"
            >
              Alpen Cols
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Route Section -->
  <section class="bg-white min-h-screen relative z-10">
    {/* Subtle checkered pattern background */}
    <div class="absolute inset-0 checkered-pattern-subtle opacity-50"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div
        class="flex flex-col md:flex-row items-center justify-between mb-16 gap-8"
      >
        <div class="text-left">
          <h2
            class="text-5xl font-black text-navy-900 tracking-tight mb-3 relative"
          >
            De Route
            <span
              class="absolute -bottom-2 left-0 w-20 h-1.5 bg-turquoise-400 rounded-full"
            ></span>
          </h2>
          <p class="text-navy-600 text-lg max-w-xl font-medium mt-6">
            Van Albertville naar de top van de Mont Ventoux.
          </p>
        </div>
      </div>

      <div
        class="mb-16 rounded-3xl border border-navy-100 bg-white/90 shadow-lg overflow-hidden"
      >
        <div class="px-6 py-5 border-b border-navy-100 bg-white/80">
          <h3 class="text-2xl font-black text-navy-900 tracking-tight">
            Route-overzicht
          </h3>
          <p class="text-sm text-navy-500 mt-1">
            Het volledige traject met alle tussenstops.
          </p>
        </div>
        <div class="h-[420px] sm:h-[520px]">
          <RouteMap gpxFiles={routeGpxFiles} towns={routeTowns} />
        </div>
      </div>

      <Timeline />
    </div>
  </section>
</BaseLayout>

<script>
  type RouteMode = "long" | "short";

  const parseValue = (value: string | null) => {
    if (!value) return undefined;
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : undefined;
  };

  const formatDistance = (distance: number) =>
    distance.toLocaleString("nl-NL", {
      minimumFractionDigits: Number.isInteger(distance) ? 0 : 1,
      maximumFractionDigits: 1,
    });

  const formatElevation = (elevation: number) =>
    Math.round(elevation).toLocaleString("nl-NL");

  const setupRouteModeTotals = () => {
    const totalDistanceElement = document.querySelector<HTMLElement>("[data-total-distance]");
    const totalElevationElement = document.querySelector<HTMLElement>("[data-total-elevation]");

    if (!totalDistanceElement || !totalElevationElement) return;

    const dayMetrics = Array.from(
      document.querySelectorAll<HTMLElement>("[data-day-metrics]"),
    )
      .map((element) => {
        const dayNumber = parseValue(element.getAttribute("data-day-number"));
        const distanceLong = parseValue(element.getAttribute("data-distance-long"));
        const elevationLong = parseValue(element.getAttribute("data-elevation-long"));
        const distanceShort = parseValue(element.getAttribute("data-distance-short"));
        const elevationShort = parseValue(element.getAttribute("data-elevation-short"));

        if (!dayNumber || distanceLong === undefined || elevationLong === undefined) {
          return undefined;
        }

        return {
          dayNumber,
          distanceLong,
          elevationLong,
          distanceShort,
          elevationShort,
          distanceElement: element.querySelector<HTMLElement>("[data-day-distance]"),
          elevationElement: element.querySelector<HTMLElement>("[data-day-elevation]"),
        };
      })
      .filter((metric): metric is NonNullable<typeof metric> => Boolean(metric));

    const selectedModes = new Map<number, RouteMode>();

    const updateCardMetric = (metric: (typeof dayMetrics)[number], mode: RouteMode) => {
      const distance =
        mode === "short" && metric.distanceShort !== undefined
          ? metric.distanceShort
          : metric.distanceLong;
      const elevation =
        mode === "short" && metric.elevationShort !== undefined
          ? metric.elevationShort
          : metric.elevationLong;

      if (metric.distanceElement) {
        metric.distanceElement.innerHTML = `${formatDistance(distance)} <span class="text-sm font-medium text-navy-400 ml-0.5">km</span>`;
      }

      if (metric.elevationElement) {
        metric.elevationElement.innerHTML = `${formatElevation(elevation)} <span class="text-sm font-medium text-navy-400 ml-0.5">m</span>`;
      }
    };

    const updateTotals = () => {
      const totals = dayMetrics.reduce(
        (sum, metric) => {
          const mode = selectedModes.get(metric.dayNumber) ?? "long";
          const distance =
            mode === "short" && metric.distanceShort !== undefined
              ? metric.distanceShort
              : metric.distanceLong;
          const elevation =
            mode === "short" && metric.elevationShort !== undefined
              ? metric.elevationShort
              : metric.elevationLong;

          return {
            distance: sum.distance + distance,
            elevation: sum.elevation + elevation,
          };
        },
        { distance: 0, elevation: 0 },
      );

      totalDistanceElement.textContent = formatDistance(totals.distance);
      totalElevationElement.textContent = formatElevation(totals.elevation);
    };

    window.addEventListener("route-mode-change", (event: Event) => {
      const customEvent = event as CustomEvent<{ dayNumber?: number; mode?: RouteMode }>;
      const dayNumber = customEvent.detail?.dayNumber;
      const mode = customEvent.detail?.mode;
      if (!dayNumber || !mode) return;

      selectedModes.set(dayNumber, mode);

      const metric = dayMetrics.find((item) => item.dayNumber === dayNumber);
      if (metric) updateCardMetric(metric, mode);

      updateTotals();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupRouteModeTotals);
  } else {
    setupRouteModeTotals();
  }
</script>
