---
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import { tripStats } from "../data/trip";
---

<BaseLayout title="Tour des Alpes Yves achterna">
  <!-- Jersey-Inspired Hero -->
  <section
    class="relative bg-turquoise-400 text-navy-900 py-12 overflow-hidden"
  >
    {/* Checkered Pattern Accent */}
    <div
      class="absolute top-0 left-0 right-0 h-16 checkered-pattern opacity-20"
    >
    </div>

    {/* Navy Shoulder Accent */}
    <div
      class="absolute top-0 right-0 w-1/4 h-40 bg-navy-500 rounded-bl-[60px] opacity-30"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8">
      <div class="text-center mx-auto space-y-6">
        {/* Logo */}
        <div class="flex justify-center">
          <div
            class="w-20 h-20 bg-white rounded-full p-4 shadow-xl ring-2 ring-navy-500/20"
          >
            <img
              src="/suffering-kotk.svg"
              alt="King of the King Logo"
              class="w-full h-full"
            />
          </div>
        </div>

        {/* Date Badge */}
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-navy-500 text-white shadow-lg"
        >
          <svg
            class="w-3.5 h-3.5 text-orange-500"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"></path>
          </svg>
          <span class="text-xs font-bold tracking-wide">
            7-15 September 2026
          </span>
        </div>

        {/* Title */}
        <div class="space-y-1">
          <h1
            class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-tight text-navy-900"
          >
            Tour des Alpes
          </h1>
          <p class="text-xl sm:text-2xl font-bold text-navy-700 tracking-wide">
            Yves achterna
          </p>
        </div>

        {/* Stats Grid */}
        <div class="grid grid-cols-3 gap-4 max-w-3xl mx-auto pt-4">
          <div
            class="bg-white/80 backdrop-blur rounded-xl p-4 shadow-lg border border-navy-500/20"
          >
            <div class="text-3xl sm:text-4xl font-black text-navy-900">
              {tripStats.totalDistance}
            </div>
            <div
              class="text-[10px] uppercase tracking-widest text-navy-600 font-bold mt-1"
            >
              Kilometer
            </div>
          </div>
          <div
            class="bg-white/80 backdrop-blur rounded-xl p-4 shadow-lg border border-navy-500/20"
          >
            <div class="text-3xl sm:text-4xl font-black text-navy-900">
              {tripStats.totalElevation.toLocaleString("nl-NL")}
            </div>
            <div
              class="text-[10px] uppercase tracking-widest text-navy-600 font-bold mt-1"
            >
              Hoogtemeters
            </div>
          </div>
          <div
            class="bg-white/80 backdrop-blur rounded-xl p-4 shadow-lg border border-navy-500/20"
          >
            <div class="text-3xl sm:text-4xl font-black text-orange-600">
              {tripStats.totalCols}
            </div>
            <div
              class="text-[10px] uppercase tracking-widest text-navy-600 font-bold mt-1"
            >
              Alpen Cols
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Route Section -->
  <section class="bg-white min-h-screen relative z-10">
    {/* Subtle checkered pattern background */}
    <div class="absolute inset-0 checkered-pattern-subtle opacity-50"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div
        class="flex flex-col md:flex-row items-center justify-between mb-16 gap-8"
      >
        <div class="text-left">
          <h2
            class="text-5xl font-black text-navy-900 tracking-tight mb-3 relative"
          >
            De Route
            <span
              class="absolute -bottom-2 left-0 w-20 h-1.5 bg-turquoise-400 rounded-full"
            ></span>
          </h2>
          <p class="text-navy-600 text-lg max-w-xl font-medium mt-6">
            Van Albertville naar de top van de Mont Ventoux.
          </p>
        </div>
      </div>

      <Timeline />
    </div>
  </section>
</BaseLayout>
